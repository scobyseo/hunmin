[InputMethod]
# Second input method, same addon. fcitx5 registers input methods by their
# own .conf under share/fcitx5/inputmethod/, each pointing at an addon; two
# registrations for one addon is the normal way to offer two configurations in
# the IM list. The per-item Layout= in the profile then selects between them
# (HunminEngine::layoutFor() reads it), which is why the layout picker in the
# addon config stays a global default rather than being duplicated per IM.
#
# Romaja transliterates to Hangul, so this is the "English input" mode: how a
# user types Korean without switching to a Hangul keyboard.
Name=Hunmin (Romaja)
Name[ko]=한국어 - 로마자
Addon=hunmin
Configurable=True
Label=로
LangCode=ko