[InputMethod]
# Display name. fcitx5 shows this in the input-method list, and the
# configtool's IM selector, so it is what a user recognises the engine by.
# Language-qualified forms fall back to the bare Name, so ko is given the
# Korean name and the untranslated default stays English.
Name=Hunmin
Name[ko]=한국어 - 훈민정음
Addon=hunmin
Configurable=True
Label=한
LangCode=ko