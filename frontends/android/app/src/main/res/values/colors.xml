<?xml version="1.0" encoding="utf-8"?>
<!--
  The dock's colours, as Material 3 baseline tokens.

  Named, not inlined in the toolbar, for two reasons: the dark values are the
  real requirement (a dock is drawn over whatever the app is doing, and a light
  pill on a dark keyboard is a flashlight), and the strip is the one place in
  this IME where the platform theme is not behind us — an InputMethodService
  gets the host app's configuration, not a keyboard theme of its own.
-->
<resources>
    <color name="hunmin_surface">#F3EDF7</color>
    <color name="hunmin_on_surface">#1D1B20</color>
    <color name="hunmin_outline">#79747E</color>
    <color name="hunmin_track">#E7E0EC</color>
    <color name="hunmin_primary">#6750A4</color>
    <color name="hunmin_on_primary">#FFFFFF</color>
    <color name="hunmin_primary_soft">#EADDFF</color>
    <!-- Green 600, per the voice state: dark enough to read white on. -->
    <color name="hunmin_mic_active">#43A047</color>

    <!--
      The Compact HUD's palette (OverlayActivity), as named tokens rather
      than the in-file literals it used to carry (review F1).

      The HUD is ALWAYS DARK — a deliberate choice, not a missing night
      variant: the settings window is a hardware-keyboard inspector drawn
      over whatever the host app is doing, and ANDROID-UI-NOTES §4 records
      that the shell and the rows must be the same dark canvas. So these
      tokens exist in BOTH the light and the night palette with the same
      dark values: the panel must not flip with the system theme, only the
      accent and the greens track the scheme (cyan is the light-scheme
      accent, the violet the dark-scheme one, matching the dock's primary
      in each mode).

      Contrast, measured with the WCAG formula on the #1E1E24 panel:
      on_hud 14.86:1, hud_secondary 5.09:1, hud_accent 9.64:1,
      hud_confirmed 7.01:1 (AA for text at every size in use).
    -->
    <color name="hunmin_hud_panel">#1E1E24</color>
    <color name="hunmin_hud_on_panel">#F2F2F7</color>
    <color name="hunmin_hud_secondary">#8E8E93</color>
    <color name="hunmin_hud_keycap">#2C2C2E</color>
    <color name="hunmin_hud_keycap_outline">#48484A</color>
    <color name="hunmin_hud_accent">#64D2FF</color>
    <color name="hunmin_hud_accent_bg">#152D3D</color>
    <!-- The dark-scheme mic green: the one green that passes AA on the panel. -->
    <color name="hunmin_hud_confirmed">#66BB6A</color>
</resources>