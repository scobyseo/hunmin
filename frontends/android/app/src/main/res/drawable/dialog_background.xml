<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog background: the compact-HUD settings panel.

     Dark slate (#1E1E24, CompactTheme.BG_PANEL in OverlayActivity.kt), not
     the light app surface: the settings window is the hardware-keyboard
     inspector, and it must read as one panel, not a light shell wrapped
     around a dark card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E1E24" />
    <stroke
        android:width="1dp"
        android:color="@color/hunmin_outline" />
    <corners android:radius="16dp" />
    <padding
        android:left="24dp"
        android:top="16dp"
        android:right="24dp"
        android:bottom="16dp" />
</shape>