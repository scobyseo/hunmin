<?xml version="1.0" encoding="utf-8"?><!--
  The 한 | A segment's active half, with a focused state since review F6:
  primary fill plus a thicker on-primary ring so the filled pill still shows
  where focus is.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hunmin_primary" />
            <stroke
                android:width="2dp"
                android:color="@color/hunmin_on_primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hunmin_primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
