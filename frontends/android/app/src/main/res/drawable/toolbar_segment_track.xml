<?xml version="1.0" encoding="utf-8"?>
<!--
  The 한 | A segment's unselected half, with a focused state since review F6
  (keyboard focus must be visible): the track fill plus a primary ring.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hunmin_track" />
            <stroke
                android:width="2dp"
                android:color="@color/hunmin_primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hunmin_track" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
