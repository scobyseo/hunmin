<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: LGPL-2.1-or-later

  Tier E2's editor fixture. It is a separate APK on purpose: the platform's
  view hierarchy is the assertion surface, so the fixture must not share a
  process with the IME whose UI is being observed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Hunmin test editor"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".EditorActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
