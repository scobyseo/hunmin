<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Hunmin.Tsf.SettingsUi.MainWindow"
    Title="Hunmin TSF settings">
  <!-- Compact, maintainer instruction 2026-10-17: "~480-560 px wide",
       compact 8-12 px margins, minimal header. Key row: ONE configurable
       binding set by key capture (한/영 전환 키; the store grammar stays
       v1:<vk>:<mods>, one entry). -->
  <StackPanel Margin="10" Spacing="8">

    <TextBlock Text="한글 입력 설정" Style="{StaticResource SubtitleTextBlockStyle}" />

    <TextBlock Text="한글 배열 (hangul)" FontSize="12" />
    <ListView x:Name="HangulList" Height="120" SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate>
          <TextBlock FontSize="13"><Run Text="{Binding Label}" /></TextBlock>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock Text="영어 배열 (latin)" FontSize="12" />
    <ListView x:Name="LatinList" Height="120" SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate>
          <TextBlock FontSize="13"><Run Text="{Binding Label}" /></TextBlock>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- the mode-toggle key row: capture, not a text field -->
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="한/영 전환 키" VerticalAlignment="Center" FontSize="12" />
      <TextBlock x:Name="ToggleKeyLabel" FontWeight="SemiBold"
                 VerticalAlignment="Center" FontSize="13" />
      <Button x:Name="ToggleKeyChangeBtn" Content="변경" Click="ToggleKeyChange_Click" FontSize="12" />
      <TextBlock x:Name="CaptureHint" Foreground="Orange" VerticalAlignment="Center" FontSize="12" />
    </StackPanel>

    <!-- the Hanja/candidate key row (issue #67): opens the Hanja candidate
         window; default the bare physical Hanja key. Same capture flow. -->
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="한자 키" VerticalAlignment="Center" FontSize="12" />
      <TextBlock x:Name="HanjaKeyLabel" FontWeight="SemiBold"
                 VerticalAlignment="Center" FontSize="13" />
      <Button x:Name="HanjaKeyChangeBtn" Content="변경" Click="HanjaKeyChange_Click" FontSize="12" />
      <TextBlock x:Name="HanjaCaptureHint" Foreground="Orange" VerticalAlignment="Center" FontSize="12" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ApplyBtn" Click="Apply_Click" Content="적용" FontSize="13" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
    </StackPanel>

    <ToggleSwitch IsEnabled="False" FontSize="12"
                  Header="자동 한/영 전환: 미정 (0.3)" IsOn="False" Margin="0" />

    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
               Text="변경 사항은 다음 입력 방법(input method) 활성화 시 적용됩니다." />

  </StackPanel>
</Window>
