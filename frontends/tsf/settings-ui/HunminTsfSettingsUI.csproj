<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Hunmin TSF settings exe (issue #71), maintainer ruling 2026-10-17:
       a separate WinUI 3 (Windows App SDK) application that edits the
       configuration store (frontends/tsf/src/config.h contract). Unpackaged,
       self-contained, WinAppSDK-self-contained so it runs beside the DLL with
       no installer dependency. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-us</DefaultLanguage>
    <AssemblyName>hunmin-tsf-settingsui</AssemblyName>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
  </ItemGroup>

</Project>
