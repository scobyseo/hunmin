build*/
artifacts/
*.tmp
__pycache__/
.cache/
compile_commands.json
obj-*/

# vendored distro source dumps fetched while debugging the fcitx5 addon
/fcitx5_*.dsc
/fcitx5_*.debian.tar.xz
/fcitx5_*.orig.tar.xz
/fcitx5-*/

# downloaded distro packages (fetched and extracted, never committed)
/*.deb

# 368 MB NIKE dump, fetched not vendored (CC-BY-SA; see
# libhunmin/data/krdict/LICENSE.md). The extracted table is committed.
/data-orig/krdict/

# tier-C worktree convenience: symlink to the 369 MB NIKE dump in the main tree,
# which .gitignore already excludes there. Never commit the link.
data-orig/krdict

# The `build*/` rule above already covers the module build dirs at any depth
# (verified with `git check-ignore -v`), but Gradle's own state dir is not named
# build/, so these need their own lines.
frontends/android/.gradle/
frontends/android/local.properties
frontends/android/.idea/
frontends/android/app/.cxx/
# Synced from libhunmin/data at build time by syncHunminData. NEVER committed:
# a second copy of the normative layout tables under frontends/ would type the
# wrong Korean while every host test stayed green (AGENTS.md, "layouts are data,
# never code").
frontends/android/app/src/main/assets/data/
logs/
frontends/android/captures/
*.iml

# NDK CMake scratch, from the jniLibs produced by tools/build-android.sh.
# Unanchored, same as the wrapper jar below: a leading slash stops at
# frontends/android/ and misses app/.cxx/.
**/.cxx/

# gradle-wrapper.jar is NOT ignored, and deliberately: without it a fresh clone
# has no way to run `./gradlew` (the wrapper script and gradle-wrapper.properties
# are committed, but the jar is what they bootstrap). 43 KB, and it is the
# standard, expected artefact to vendor for a Gradle module.

# worktree-only: gitignored 368 MB source dumps live in the primary worktree
/data-orig/krdict
/data-orig/aihub

# generated evaluation output (regenerated by tools) -- never committed
out/

# the settings exe (#71): the publish output is a 169 MB self-contained
# artefact; bin/obj are .NET build state. Never committed.
frontends/tsf/settings-ui/publish/
frontends/tsf/settings-ui/bin/
frontends/tsf/settings-ui/obj/
