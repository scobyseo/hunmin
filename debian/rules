#!/usr/bin/make -f
export LC_ALL=C

%:

	dh $@

override_dh_auto_configure:
	# The addon installs alongside fcitx5's own modules; without this option
	# Fcitx5UtilsConfig.cmake points FCITX_INSTALL_* at $(prefix)/lib/fcitx5
	# instead of the multiarch path fcitx5 actually loads from.
	# FETCHCONTENT_SOURCE_DIR_GOOGLETEST: pre-populated googletest source dir
	# for FETCHCONTENT_FULLY_DISCONNECTED builds (CI sets this via
	# tools/build-release.sh; local builds leave it unset so FetchContent
	# downloads googletest normally).
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON \
		-DFCITX_INSTALL_USE_FCITX_SYS_PATHS=On \
		$(if $(FETCHCONTENT_SOURCE_DIR_GOOGLETEST),-DFETCHCONTENT_SOURCE_DIR_GOOGLETEST=$(FETCHCONTENT_SOURCE_DIR_GOOGLETEST))

# override_dh_auto_test runs ctest, which reaches the Android-tier scripts
# (android-unit.sh, android-trace-emit.sh, build-host-jni.sh). Two packaging-tree
# facts, both measured on CI 2026-10-13 (issue #8), are handled by the exports
# inside the recipe below, scoped there so no other debian/rules target sees
# them:
#
# 1. HUNMIN_BUILD_DIR: the engine .so and host JNI shim live in
#    obj-x86_64-linux-gnu, not build/. The scripts default to build/ (correct
#    for a plain `cmake -B build` and the linux CI job) and without this fail
#    with "libhunmin.so missing" even though the engine is built.
#
# 2. HOME: dpkg-buildpackage builds under fakeroot (uid 0), and the Gradle
#    wrapper refuses to create /root/.gradle/.../*.lck as uid 0. Point HOME at
#    a writable dir so engine-android-e1 / android-mutations can run under the
#    fake root.
#
# MEASURED 2026-10-14, issue #59: this recipe is 402 s of a 460 s package
# build, and 386 of those seconds are engine-android-e1 (185.68 s),
# android-mutations (138.45 s) and frontend-mutations (61.86 s). Two of the
# three are the Android adapter's, which the .deb does not ship and which
# nothing in the package build exercises: the .deb contains the engine, the
# addon and the fcitx5 integration, and the adapter's own gate is the `android`
# job at ci.yml:166. So the tier-E1 labels are excluded here, visibly.
#
# -j4: same suite on the same host measures 189.76 s serial and 47.82 s at
# -j16, and the three heavyweight tests cap the gain for the reason given in
# ci.yml -- RUN_SERIAL on engine-android-e1, nine sequential Gradle runs in
# android-mutations. -j4 is what this job's runner has.
#
# The exclusion is written as -LE 'tier-E1', not as a list of test names, for
# the reason docs/TESTING.md gives: a label is declared once next to the test
# that earns it and does not move when the corpus does, whereas a name list
# silently stops matching the moment a test is renamed. The property the
# CMakeLists.txt:105 comment states -- a filtered run cannot prove what it
# left out — is what the comment above this recipe is for: it names what is
# left out and why, in the one place a reader of the package build will look.
override_dh_auto_test:
	mkdir -p $(CURDIR)/.deb-test-home
	cd obj-x86_64-linux-gnu && \
		HUNMIN_BUILD_DIR=$(CURDIR)/obj-x86_64-linux-gnu \
		HOME=$(CURDIR)/.deb-test-home \
		ctest -j4 --output-on-failure -LE 'tier-E1'

# The .deb job's last failure before this: dh_shlibdeps, measured on CI
# 2026-10-13 (issue #8's job, run 38398739533) after the whole 63-test suite
# passed inside the package build:
#
#   dpkg-shlibdeps: error: no dependency information found for
#   /lib/x86_64-linux-gnu/libFcitx5Core.so.7
#   (used by debian/hunmin/usr/lib/x86_64-linux-gnu/fcitx5/libhunmin.so)
#   Hint: check if the library actually comes from a package.
#   make: *** [debian/rules:6: binary] Error 25
#
# dpkg answers that question by running `dpkg -S <library-file>` and reading the
# owning package's /var/lib/dpkg/info/*.symbols or *.shlibs. A source-built
# fcitx5 has no owning package: the CI job installs fcitx5 5.1.13 from source
# into /usr (docs/ENVIRONMENT.md records the same route on this host), so the
# headers and cmake configs are there and the addon compiles and links, while
# nothing in dpkg's database describes those .so files. It is the same fact the
# CI step already records by passing -d to dpkg-buildpackage: the dependency is
# satisfied, only the package metadata is missing.
#
# --ignore-missing-info is dpkg-shlibdeps(1)'s documented answer to exactly this
# ("Do not fail if dependency information can't be found for a shared library").
# It was measured before being committed here rather than assumed: pointed at the
# real addon with an empty --admindir -- the same shape as "no package owns the
# library", this host's dpkg 1.23.7 -- the run prints the error above and exits
# nonzero, and exits 0 with the flag (the exit code differs by dpkg version:
# 1 here, 25 on the CI runner's 1.22.5). debian/shlibs.local was tried first, in
# both the soname and the absolute-path form the man page allows, and does not
# apply: still nonzero, still no shlibs:Depends.
#
# WHAT THIS DOES NOT ASSERT:
# - Measured on a host where fcitx5 IS packaged (this one, any Debian machine),
#   the flag costs nothing at all: the .deb still comes out with
#   libfcitx5core7 (>= 5.1.19), libfcitx5config6 (>= ...) and libfcitx5utils2
#   (>= ...) in shlibs:Depends, because --ignore-missing-info only skips what
#   cannot be resolved, not what can. It is on a source-built fcitx5 -- i.e. CI
#   -- that those three drop out of the dependency set, and that
#   debian/control's hand-written `Depends: fcitx5` is then the whole of it.
# - So a CI-built .deb declares fcitx5 UNVERSIONED while the addon needs
#   >= 5.1.13 (FCITX_ADDON_FACTORY_V2 at frontends/fcitx5/src/engine.cpp). That
#   gap is a packaging decision about what the 0.1 .deb promises, and is
#   deliberately not decided here.
# - The flag also stops the BUILD HOST from failing on any unowned NEEDED
#   library, not only fcitx5's. On such a host that check is gone; a build
#   where fcitx5 is packaged (via tools/build-release.sh) still resolves every
#   dependency and is where a missing one still shows up.
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
