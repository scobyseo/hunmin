# Android integration (tier-E). Rationale: docs/DESIGN-BUILD.md.
if(NOT BUILD_TESTING OR NOT Python3_FOUND)
  return()
endif()
if(WIN32)
  find_program(HUNMIN_BASH_EXECUTABLE NAMES bash HINTS "$ENV{ProgramFiles}/Git/bin" "$ENV{ProgramFiles}/Git/usr/bin")
endif()
find_program(JAVA_EXECUTABLE java HINTS $ENV{JAVA_HOME}/bin)
# Sandbox strategy is named so CI is deterministic; in-tree is the caller's to honour (docs/DESIGN-BUILD.md#android-sandbox-mutations).
if(JAVA_EXECUTABLE AND DEFINED ENV{ANDROID_HOME})
  hunmin_android_shell_command(HUNMIN_ANDROID_E1_COMMAND engine-android-e1 ${CMAKE_CURRENT_SOURCE_DIR}/tools/android-unit.sh)
  hunmin_add_test(NAME engine-android-e1 COMMAND ${HUNMIN_ANDROID_E1_COMMAND} LABELS tier-E1 slow SKIP_RETURN_CODE 77 TIMEOUT 900 RUN_SERIAL TRUE)
  hunmin_add_test(NAME builds-android COMMAND ${CMAKE_COMMAND} -E chdir ${CMAKE_CURRENT_SOURCE_DIR}/frontends/android $<IF:$<BOOL:$<PLATFORM_ID:Windows>>,gradlew.bat,./gradlew> --no-daemon assembleDebug LABELS guard SKIP_RETURN_CODE 77 TIMEOUT 900 RUN_SERIAL TRUE)
  if(WIN32 AND HUNMIN_BASH_EXECUTABLE)
    hunmin_add_test(NAME android-mutations COMMAND ${CMAKE_COMMAND} -E env HUNMIN_MUTATION_STRATEGY=sandbox HUNMIN_BUILD_DIR=${CMAKE_BINARY_DIR} HUNMIN_CMAKE=${CMAKE_COMMAND} ${HUNMIN_BASH_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/android-mutations.sh LABELS tier-E1 mutation slow SKIP_RETURN_CODE 77 TIMEOUT 1800)
  elseif(WIN32)
    hunmin_add_test(NAME android-mutations COMMAND ${Python3_EXECUTABLE} -c "print('skip: no bash on PATH for android-mutations', file=__import__('sys').stderr) or __import__('sys').exit(77)" LABELS tier-E1 mutation slow SKIP_RETURN_CODE 77 TIMEOUT 1800)
  else()
    hunmin_add_test(NAME android-mutations COMMAND ${CMAKE_COMMAND} -E env HUNMIN_MUTATION_STRATEGY=sandbox HUNMIN_BUILD_DIR=${CMAKE_BINARY_DIR} HUNMIN_CMAKE=${CMAKE_COMMAND} ${CMAKE_CURRENT_SOURCE_DIR}/tools/android-mutations.sh LABELS tier-E1 mutation slow SKIP_RETURN_CODE 77 TIMEOUT 1800)
  endif()
endif()
find_program(ADB_EXECUTABLE adb HINTS $ENV{ANDROID_HOME}/platform-tools)
if(ADB_EXECUTABLE AND EXISTS "$ENV{ANDROID_NDK}")
  hunmin_android_shell_command(HUNMIN_ANDROID_GOLDENS_COMMAND engine-android-goldens ${CMAKE_CURRENT_SOURCE_DIR}/tools/android-golden-check.sh)
  hunmin_add_test(NAME engine-android-goldens COMMAND ${HUNMIN_ANDROID_GOLDENS_COMMAND} LABELS tier-E0 SKIP_RETURN_CODE 77 TIMEOUT 600 RUN_SERIAL TRUE)
  hunmin_android_shell_command(HUNMIN_ANDROID_E2E_COMMAND engine-android-e2e ${CMAKE_CURRENT_SOURCE_DIR}/tools/android-e2e.sh)
  hunmin_add_test(NAME engine-android-e2e COMMAND ${HUNMIN_ANDROID_E2E_COMMAND} LABELS tier-E2 SKIP_RETURN_CODE 77 TIMEOUT 1200 RUN_SERIAL TRUE)
  hunmin_android_shell_command(HUNMIN_ANDROID_ESPRESSO_COMMAND engine-android-espresso ${CMAKE_CURRENT_SOURCE_DIR}/tools/android-espresso.sh)
  hunmin_add_test(NAME engine-android-espresso COMMAND ${HUNMIN_ANDROID_ESPRESSO_COMMAND} LABELS tier-E2 SKIP_RETURN_CODE 77 TIMEOUT 1800 RUN_SERIAL TRUE)
endif()
hunmin_add_test(NAME align-16k COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/check-align-16k.py LABELS tier-E SKIP_RETURN_CODE 77)
