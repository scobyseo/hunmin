# Desktop frontend integration (tier-D1/D2/D3). Rationale: docs/DESIGN-BUILD.md.
if(NOT BUILD_TESTING OR NOT Python3_FOUND)
  return()
endif()
hunmin_add_test(NAME frontend-invariants COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/check-frontend-invariants.py LABELS tier-D1)
if(HUNMIN_HAS_FCITX5)
  # HUNMIN_MUTATION_CACHE pins the sandbox to this tree's toolchain, not a foreign build*/CMakeCache.txt.
  hunmin_add_test(NAME frontend-mutations COMMAND ${CMAKE_COMMAND} -E env HUNMIN_MUTATION_STRATEGY=sandbox HUNMIN_MUTATION_CACHE=${CMAKE_CURRENT_BINARY_DIR}/CMakeCache.txt ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/frontend-mutations.py LABELS tier-D1 tier-D2 mutation slow TIMEOUT 900)
endif()
find_package(X11)
find_program(PKG_CONFIG_EXECUTABLE pkg-config)
if(PKG_CONFIG_EXECUTABLE)
  execute_process(COMMAND ${PKG_CONFIG_EXECUTABLE} --variable=libdir Fcitx5Core OUTPUT_VARIABLE d3_libdir OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE d3_rc)
  execute_process(COMMAND ${PKG_CONFIG_EXECUTABLE} --variable=prefix Fcitx5Core OUTPUT_VARIABLE d3_prefix OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
if(d3_rc EQUAL 0 AND d3_libdir)
  set(d3_addon_dir "${d3_libdir}/fcitx5")
  set(d3_pkgdata_dir "${d3_prefix}/share/fcitx5")
endif()
if(X11_FOUND AND TARGET hunmin_addon AND EXISTS "${d3_addon_dir}" AND EXISTS "${d3_pkgdata_dir}")
  message(STATUS "D3: X11 + stock fcitx5 at ${d3_addon_dir}, ${d3_pkgdata_dir}")
  # dkit, not X11::X11: X11's XIM would silently answer locally (docs/D3-ROOT-CAUSE.md).
  add_executable(xim-harness tests/e2e/xim-harness.c)
  find_file(D3_IMDKIT_SO NAMES libxcb-imdkit.so.1 libxcb-imdkit.so HINTS ${d3_addon_dir} /usr/lib/${CMAKE_LIBRARY_ARCHITECTURE} /usr/lib /usr/local/lib REQUIRED)
  find_file(D3_XCB_SO NAMES libxcb.so.1 libxcb.so HINTS /usr/lib/${CMAKE_LIBRARY_ARCHITECTURE} /usr/lib /usr/local/lib REQUIRED)
  find_package(PkgConfig)
  if(PKG_CONFIG_FOUND)
    pkg_check_modules(D3_XKB xkbcommon)
  endif()
  target_link_libraries(xim-harness PRIVATE ${D3_IMDKIT_SO} ${D3_XCB_SO})
  if(D3_XKB_FOUND)
    target_include_directories(xim-harness PRIVATE ${D3_XKB_INCLUDE_DIRS})
    target_link_libraries(xim-harness PRIVATE ${D3_XKB_LIBRARIES})
    target_link_directories(xim-harness PRIVATE ${D3_XKB_LIBRARY_DIRS})
  else()
    message(WARNING "D3: xkbcommon not found; the XIM harness cannot resolve forwarded keys and D3 will not observe pass-through keys")
  endif()
  message(STATUS "D3: XIM harness links ${D3_IMDKIT_SO}")
  add_executable(testfcitx5d3 frontends/fcitx5/test/testfcitx5d3.cpp)
  target_link_libraries(testfcitx5d3 PRIVATE GTest::gtest_main)
  set(HUNMIN_D3_HEAD --run-d3 ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/run-d3.sh --sim $<TARGET_FILE:hunmin-sim> --data ${CMAKE_CURRENT_SOURCE_DIR}/libhunmin/data)
  set(HUNMIN_D3_MID --typer ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/xtest-type.py --addon-dir ${CMAKE_BINARY_DIR}/fcitx5-addon --im-conf ${CMAKE_CURRENT_BINARY_DIR}/frontends/fcitx5/src/hunmin.conf --addon-conf ${CMAKE_CURRENT_BINARY_DIR}/frontends/fcitx5/src/hunmin-addon.conf --src ${CMAKE_CURRENT_SOURCE_DIR})
  set(HUNMIN_D3_FOOT --sys-addon-dir ${d3_addon_dir} --sys-pkgdatadir ${d3_pkgdata_dir})
  hunmin_add_test(NAME engine-d3-x11 COMMAND testfcitx5d3 --mode x11 ${HUNMIN_D3_HEAD} --harness $<TARGET_FILE:xim-harness> ${HUNMIN_D3_MID} --cases ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/cases.tsv ${HUNMIN_D3_FOOT} LABELS tier-D3 slow SKIP_RETURN_CODE 77 TIMEOUT 300)
  foreach(gtkver 3 4)
    hunmin_add_test(NAME engine-d3-gtk${gtkver} COMMAND testfcitx5d3 --mode gtk${gtkver} --gtk-ver ${gtkver}.0 ${HUNMIN_D3_HEAD} --harness ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/gtk-harness.py ${HUNMIN_D3_MID} --cases ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/cases.tsv ${HUNMIN_D3_FOOT} LABELS tier-D3 slow SKIP_RETURN_CODE 77 TIMEOUT 300)
  endforeach()
  hunmin_add_test(NAME engine-d3-edit COMMAND testfcitx5d3 --mode edit --edit-cases ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/cases-edit.tsv ${HUNMIN_D3_HEAD} --harness $<TARGET_FILE:xim-harness> ${HUNMIN_D3_MID} --cases ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/cases.tsv ${HUNMIN_D3_FOOT} LABELS tier-D3 slow SKIP_RETURN_CODE 77 TIMEOUT 300)
  hunmin_add_test(NAME d3-reservation COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/tools/d3-reservation-test.sh LABELS tier-D3 slow SKIP_RETURN_CODE 77 TIMEOUT 120)
  hunmin_add_test(NAME engine-d3-candidate COMMAND testfcitx5d3 --mode candidate ${HUNMIN_D3_HEAD} --harness $<TARGET_FILE:xim-harness> ${HUNMIN_D3_MID} --cases ${CMAKE_CURRENT_SOURCE_DIR}/tests/e2e/cases-candidate.tsv ${HUNMIN_D3_FOOT} LABELS tier-D3 slow SKIP_RETURN_CODE 77 TIMEOUT 300)
else()
  message(STATUS "D3: skipped (X11=${X11_FOUND}, pkg-config=${PKG_CONFIG_EXECUTABLE})")
endif()
