# hunmin_add_test (H2) and the Android shell helper. Rationale: docs/DESIGN-BUILD.md.
function(hunmin_add_test)
  set(options "")
  set(oneValueArgs NAME TIMEOUT SKIP_RETURN_CODE RUN_SERIAL WORKING_DIRECTORY)
  set(multiValueArgs COMMAND LABELS ENVIRONMENT)
  cmake_parse_arguments(ARG "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
  if(NOT ARG_NAME)
    message(FATAL_ERROR "hunmin_add_test: NAME required")
  endif()
  if(NOT ARG_COMMAND)
    message(FATAL_ERROR "hunmin_add_test: COMMAND required for ${ARG_NAME}")
  endif()
  add_test(NAME ${ARG_NAME} COMMAND ${ARG_COMMAND})
  if(ARG_LABELS)
    set_tests_properties(${ARG_NAME} PROPERTIES LABELS "${ARG_LABELS}")
  endif()
  if(ARG_TIMEOUT)
    set_tests_properties(${ARG_NAME} PROPERTIES TIMEOUT ${ARG_TIMEOUT})
  endif()
  if(ARG_SKIP_RETURN_CODE)
    set_tests_properties(${ARG_NAME} PROPERTIES SKIP_RETURN_CODE ${ARG_SKIP_RETURN_CODE})
  endif()
  if(ARG_RUN_SERIAL)
    set_tests_properties(${ARG_NAME} PROPERTIES RUN_SERIAL ${ARG_RUN_SERIAL})
  endif()
  if(ARG_WORKING_DIRECTORY)
    set_tests_properties(${ARG_NAME} PROPERTIES WORKING_DIRECTORY ${ARG_WORKING_DIRECTORY})
  endif()
  if(ARG_ENVIRONMENT)
    set_tests_properties(${ARG_NAME} PROPERTIES ENVIRONMENT "${ARG_ENVIRONMENT}")
  endif()
endfunction()
function(hunmin_android_shell_command out name)
  if(WIN32)
    if(HUNMIN_BASH_EXECUTABLE)
      set(${out} ${HUNMIN_BASH_EXECUTABLE} ${ARGN} PARENT_SCOPE)
    else()
      set(${out} ${Python3_EXECUTABLE} -c "print('skip: no bash on PATH for ${name}', file=__import__('sys').stderr) or __import__('sys').exit(77)" PARENT_SCOPE)
    endif()
  else()
    set(${out} ${ARGN} PARENT_SCOPE)
  endif()
endfunction()
