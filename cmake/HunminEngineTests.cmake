# Engine golden coverage (tier-A goldens over hunmin-sim). Rationale: docs/BUILD-SYSTEM.md.
if(BUILD_TESTING AND Python3_FOUND AND HUNMIN_HAS_LIBHANGUL AND HUNMIN_SH)
  hunmin_add_test(NAME goldens-reproducible COMMAND ${HUNMIN_SH} ${CMAKE_CURRENT_SOURCE_DIR}/tools/regen-goldens.sh ${CMAKE_CURRENT_BINARY_DIR}/goldens-check ${CMAKE_CURRENT_SOURCE_DIR} check LABELS tier-A)
endif()
if(NOT BUILD_TESTING)
  return()
endif()
set(HUNMIN_STD_LAYOUTS dubeolsik dubeolsik-yet sebeolsik-3-2 sebeolsik-3-90 sebeolsik-final sebeolsik-noshift sebeolsik-yet romaja dvorak colemak)
foreach(l IN LISTS HUNMIN_STD_LAYOUTS)
  hunmin_add_test(NAME engine-golden-${l} COMMAND hunmin-sim --data ${CMAKE_CURRENT_SOURCE_DIR}/libhunmin/data --check ${CMAKE_CURRENT_SOURCE_DIR}/tests/golden/ref-${l}.jsonl LABELS tier-A)
endforeach()
file(GLOB HUNMIN_WORDS_GOLDENS "${CMAKE_CURRENT_SOURCE_DIR}/tests/golden/words-*.jsonl")
file(GLOB HUNMIN_CULTURAL_GOLDENS "${CMAKE_CURRENT_SOURCE_DIR}/tests/golden/cultural-*.jsonl")
list(APPEND HUNMIN_WORDS_GOLDENS ${HUNMIN_CULTURAL_GOLDENS})
file(GLOB HUNMIN_COVERAGE_GOLDENS "${CMAKE_CURRENT_SOURCE_DIR}/tests/golden/coverage-*.jsonl")
list(APPEND HUNMIN_WORDS_GOLDENS ${HUNMIN_COVERAGE_GOLDENS})
foreach(g IN LISTS HUNMIN_WORDS_GOLDENS)
  get_filename_component(w "${g}" NAME_WE)
  hunmin_add_test(NAME engine-golden-${w} COMMAND hunmin-sim --data ${CMAKE_CURRENT_SOURCE_DIR}/libhunmin/data --check ${g} LABELS tier-A)
endforeach()
