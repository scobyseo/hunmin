# Cross-platform conformance (tier-C). Rationale: docs/DESIGN-BUILD.md.
if(NOT BUILD_TESTING)
  return()
endif()
hunmin_add_test(NAME conformance-coverage COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/conformance-coverage.py --check LABELS tier-C guard)
if(TARGET trace-emit)
  file(GLOB HUNMIN_CONFORMANCE_TRACES "${CMAKE_CURRENT_SOURCE_DIR}/tests/conformance/x11/*.trace.in")
  set(HUNMIN_CONFORMANCE_SAFE "")
  foreach(t IN LISTS HUNMIN_CONFORMANCE_TRACES)
    string(REPLACE ";" "\\;" t_esc "${t}")
    list(APPEND HUNMIN_CONFORMANCE_SAFE "${t_esc}")
  endforeach()
  foreach(t IN LISTS HUNMIN_CONFORMANCE_SAFE)
    string(REPLACE "\\;" ";" t_real "${t}")
    file(RELATIVE_PATH rel "${CMAKE_CURRENT_SOURCE_DIR}" "${t_real}")
    string(REGEX REPLACE "[^A-Za-z0-9._-]" "_" name "${rel}")
    hunmin_add_test(NAME conformance-${name} COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/trace-check.py "${t_real}" --runner $<TARGET_FILE:trace-emit> LABELS tier-C SKIP_RETURN_CODE 77 TIMEOUT 120)
  endforeach()
else()
  message(STATUS "Tier C: skipped (build with -DHUNMIN_TRACE_BUILD=ON)")
endif()
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/tools/android-trace-emit.sh")
  file(GLOB HUNMIN_ANDROID_CONFORMANCE_TRACES "${CMAKE_CURRENT_SOURCE_DIR}/tests/conformance/android/*.trace.in")
  if(HUNMIN_ANDROID_CONFORMANCE_TRACES)
    set(HUNMIN_ANDROID_CONFORMANCE_SAFE "")
    foreach(t IN LISTS HUNMIN_ANDROID_CONFORMANCE_TRACES)
      string(REPLACE ";" "\\;" t_esc "${t}")
      list(APPEND HUNMIN_ANDROID_CONFORMANCE_SAFE "${t_esc}")
    endforeach()
    foreach(t IN LISTS HUNMIN_ANDROID_CONFORMANCE_SAFE)
      string(REPLACE "\\;" ";" t_real "${t}")
      file(RELATIVE_PATH rel "${CMAKE_CURRENT_SOURCE_DIR}" "${t_real}")
      string(REGEX REPLACE "[^A-Za-z0-9._-]" "_" name "${rel}")
      hunmin_add_test(NAME engine-android-conformance-${name} COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/trace-check.py "${t_real}" --runner ${CMAKE_CURRENT_SOURCE_DIR}/tools/android-trace-emit.sh LABELS tier-C SKIP_RETURN_CODE 77 TIMEOUT 120 ENVIRONMENT "HUNMIN_BUILD_DIR=${CMAKE_BINARY_DIR}")
    endforeach()
  else()
    message(STATUS "Tier C Android: no trace files found")
  endif()
else()
  message(STATUS "Tier C Android: skipped (tools/android-trace-emit.sh not found)")
endif()
if(NOT BUILD_TESTING OR NOT Python3_FOUND)
  return()
endif()
if(TARGET hunmin_addon AND NOT HUNMIN_TRACE)
  hunmin_add_test(NAME trace-optout COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/check-trace-optout.py $<TARGET_FILE:hunmin_addon> LABELS tier-C)
endif()
hunmin_add_test(NAME keymap-fixture COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/keymap-fixture.py LABELS tier-C SKIP_RETURN_CODE 77)
